# Presty Motors — Production Environment Configuration Template
# Copy this file to .env.production and populate real credentials.

# -------------------------------------------------------------
# 1. Application & Domain
# -------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://presty-motors.com
PORT=3000

# -------------------------------------------------------------
# 2. Database (PostgreSQL Connection Pooling)
# -------------------------------------------------------------
# Primary transaction pooler URL (e.g., Supabase / Neon / AWS RDS / Self-hosted PgBouncer)
DATABASE_URL="postgresql://presty_admin:SECURE_STRONG_PASSWORD@db.presty-motors.com:5432/presty_motors_prod?sslmode=require&connection_limit=20&pool_timeout=10"

# Direct URL for running Prisma migrations
DIRECT_URL="postgresql://presty_admin:SECURE_STRONG_PASSWORD@db.presty-motors.com:5432/presty_motors_prod?sslmode=require"

# -------------------------------------------------------------
# 3. Cloudflare R2 Media & Showroom Asset Storage
# -------------------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key_id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
CLOUDFLARE_R2_BUCKET_NAME="presty-motors-media"
CLOUDFLARE_R2_PUBLIC_DOMAIN="https://cdn.presty-motors.com"

# -------------------------------------------------------------
# 4. Payment Gateway (Stripe)
# -------------------------------------------------------------
STRIPE_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# -------------------------------------------------------------
# 5. Transactional Email & Notifications (Resend)
# -------------------------------------------------------------
RESEND_API_KEY="re_..."
EMAIL_FROM="Presty Motors <commandes@presty-motors.com>"
EMAIL_LOGISTICS="logistique@presty-motors.com"

# -------------------------------------------------------------
# 6. Admin Authentication & Session Security
# -------------------------------------------------------------
NEXTAUTH_SECRET="GENERATE_STRONG_RANDOM_64_CHAR_SECRET_HEX"
NEXTAUTH_URL="https://presty-motors.com"
